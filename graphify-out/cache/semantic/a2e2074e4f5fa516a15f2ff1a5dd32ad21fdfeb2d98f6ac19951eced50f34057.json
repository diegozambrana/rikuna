 "rikuna_prd_schema_basedatos_rikuna_query_8_2", "label": "Query 8.2: Discovery recommendations", "file_type": "rationale", "source_file": "specs/RIKUNA-PRD-schema-basedatos-rikuna.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Well-rated (imdb_rating>=7.0), available, unseen titles outside the watchlist, limited to 50 rows, with a minimum vote floor (imdb_votes>=5000) to avoid false 'hidden gems' with too few votes."}, {"id": "rikuna_prd_schema_basedatos_rikuna_manually_edited_rule", "label": "manually_edited overwrite-protection rule", "file_type": "rationale", "source_file": "specs/RIKUNA-PRD-schema-basedatos-rikuna.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "user_media_status.manually_edited=true protects a user's in-app manual edits from being silently overwritten by a later IMDb CSV reimport; every manual write must set source='manual' and manually_edited=true, and reimport logic must check this flag before overwriting watched/want_to_watch fields."}], "edges": [{"source": "rikuna_prd_schema_basedatos_rikuna_doc", "target": "rik_11_public_list_sharing_esp_public_code_mechanism", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "specs/RIKUNA-PRD-schema-basedatos-rikuna.md", "source_location": null, "weight": 0.85}, {"source": "rikuna_prd_schema_basedatos_rikuna_query_8_1", "target": "rikuna_prd_schema_basedatos_rikuna_doc", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/RIKUNA-PRD-schema-basedatos-rikuna.md", "source_location": null, "weight": 1.0}, {"source": "rikuna_prd_schema_basedatos_rikuna_query_8_2", "target": "rikuna_prd_schema_basedatos_rikuna_doc", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/RIKUNA-PRD-schema-basedatos-rikuna.md", "source_loc