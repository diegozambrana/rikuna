{"nodes": [{"id": "20260809151800_imdb_import_stub_insert_policies_stub_insert_design", "label": "Stub-Only Insert Policy Design (RIK-4)", "file_type": "rationale", "source_file": "supabase/migrations/20260809151800_imdb_import_stub_insert_policies.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RIK-1's RLS migration (20260809134405) only granted SELECT on the catalog group, leaving no authenticated-role write policy, so a user-triggered IMDb import could not create stub titles/genres/people without a service-role client. This migration is policy-only \u2014 no table or column changes. media_items insert is scoped to is_stub = true so an authenticated user can only ever insert a stub row, never a fully-enriched one. genres/people/media_genres/media_people have no owner or stub concept of their own, so their insert is left unrestricted for the authenticated role, matching what the ingestion/catalog service-role path would produce."}, {"id": "20260809151800_imdb_import_stub_insert_policies_media_items_insert_stub", "label": "media_items_insert_stub policy", "file_type": "code", "source_file": "supabase/migrations/20260809151800_imdb_import_stub_insert_policies.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "20260809151800_imdb_import_stub_insert_policies_genres_insert", "label": "genres_insert policy", "file_type": "code", "source_file": "supabase/migrations/20260809151800_imdb_import_stub_insert_policies.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "20260809151800_imdb_import_stub_insert_policies_people_insert", "label": "people_insert policy", "file_type": "code", "source_file": "supabase/migrations/20260809151800_imdb_import_stub_insert_policies.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}