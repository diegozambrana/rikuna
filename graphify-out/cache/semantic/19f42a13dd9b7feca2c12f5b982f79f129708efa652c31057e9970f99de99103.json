{"nodes": [{"id": "20260809134405_enable_rls_policies_rls_design", "label": "RLS Enablement Design (RIK-1)", "file_type": "rationale", "source_file": "supabase/migrations/20260809134405_enable_rls_policies.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RLS is enabled on ALL 14 tables, not only personal-data ones, because Supabase's default project-level privileges grant the authenticated role table-level INSERT/UPDATE/DELETE on public schema tables; restricting RLS to personal-data tables would leave catalog tables writable by any authenticated end user. service_role bypasses RLS automatically (BYPASSRLS), so ingestion routines are unaffected. auth.uid() calls are wrapped in (select auth.uid()) per Supabase's RLS performance guidance (initplan caching instead of a per-row function call) \u2014 behaviorally identical to the spec doc's bare auth.uid()."}, {"id": "20260809134405_enable_rls_policies_media_items_select", "label": "media_items_select policy", "file_type": "code", "source_file": "supabase/migrations/20260809134405_enable_rls_policies.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "20260809134405_enable_rls_policies_user_lists_select", "label": "user_lists_select policy", "file_type": "code", "source_file": "supabase/migrations/20260809134405_enable_rls_policies.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "20260809134405_enable_rls_policies_user_lists_write", "label": "user_lists_write policy", "file_type": "code", "source_file": "supabase/migrations/20260809134405_enable_rls_policies.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "20260809134405_enable_rls_policies_user_lists_update", "label": "user_lists_update policy", "file_type": "code", "source_file": "supabase/migrat